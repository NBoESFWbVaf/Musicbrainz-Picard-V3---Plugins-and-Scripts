title: 02 Track und CD Nummern
script_language_version: '1.1'
script: |
  # CD und Tracknummern zwei- bzw. dreistellig
  $if(%tracknumber%,$set(tracknumber,$num(%tracknumber%,$if($gte(%totaltracks%,100),3,2))))
  $set(totaltracks,$num(%totaltracks%,$if($gte(%totaltracks%,100),3,2)))
  $if(%discnumber%,$set(discnumber,$num(%discnumber%,$if($gte(%discnumber%,100),3,2))))
  $set(totaldiscs,$num(%totaldiscs%,$if($gte(%totaldiscs%,100),3,2)))
id: 1f29ebb6-b99c-43bb-92e7-d83e269160e0
